# Copy this file to .maestro/.env.local, which git ignores, and fill it in.
# Use a Firebase test phone number (Firebase console > Authentication > Sign-in method
# > Phone > Phone numbers for testing), never a real one: its code never changes and no SMS is sent.

# The country as the app's country list shows it, for example: United States
TEST_PHONE_COUNTRY=
# The number without the country code, digits only, for example: 6505551234
TEST_PHONE_NUMBER=
# The verification code set for that test number, for example: 123456
TEST_SMS_CODE=
