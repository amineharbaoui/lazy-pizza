{
    "permissions": {
        "allow": [
            "Bash(*)",
            "Edit(*)"
        ],
        "deny": [
            "Bash(git push*)",
            "Bash(rm -rf*)",
            "Bash(rm -fr*)",
            "Bash(git tag spec-lock*)",
            "Bash(git tag -f spec-lock*)",
            "Bash(git tag -d spec-lock*)"
        ],
        "additionalDirectories": [
            "~/.gradle",
            "~/Library/Android/sdk"
        ]
    }
}
