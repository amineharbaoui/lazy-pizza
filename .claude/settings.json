{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(ktlint *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git reset --soft *)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)"
    ],
    "ask": [
      "Bash(gh * --repo *)",
      "Bash(gh * --repo=*)",
      "Bash(gh * -R*)",
      "Bash(gh * *://*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ktlint-edited-file.sh\""
          }
        ]
      }
    ]
  }
}
